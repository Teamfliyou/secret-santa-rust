# Copie ce fichier en `.env` puis adapte-le. Ne commit jamais `.env`.

# Compte administrateur (créé au premier démarrage).
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et affiché UNE FOIS dans les logs.
# Si tu changes ADMIN_PASSWORD plus tard, le mot de passe est mis à jour au redémarrage.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Emplacement de la base SQLite (en Docker : /data/santa.db, volume persistant).
DATABASE_PATH=data/santa.db

# Adresse d'écoute.
BIND_ADDR=0.0.0.0:3000

# true derrière HTTPS (production) : le cookie de session n'est envoyé qu'en HTTPS.
COOKIE_SECURE=false

# true uniquement derrière un reverse proxy de confiance (Caddy, Nginx…) qui renseigne X-Forwarded-For.
# Sert à limiter les tentatives de connexion par adresse IP.
TRUST_PROXY=false

# Durée de vie d'une session, en jours.
SESSION_DAYS=30

# Niveau de logs.
RUST_LOG=secret_santa=info
